# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs
# une fois le projet Supabase créé (voir docs/GUIDE_COMPTES_CLOUD.md).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : donne un accès total, contourne les policies RLS.
# Uniquement utilisée côté serveur pour des opérations d'administration futures.
# Ne jamais exposer côté client, ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
